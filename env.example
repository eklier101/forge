# =============================================================================
# Forge .env example — copy to .env and replace every "change_me" value.
# Never commit a real .env. See docs/SELF_HOST.md and docker-compose.public.yml.
# =============================================================================

# Postgres
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_change_me
POSTGRES_DB=forge

# API
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
# Host port published by Compose (api container still listens on 3000)
FORGE_HTTP_PORT=3030
# Optional bootstrap default — prefer setting Public URL in Admin panel.
# Use your Cloudflare hostname OR leave blank and use LAN IP in the app.
PUBLIC_BASE_URL=

# Shared token for sync-worker → API (also settable in Admin)
INTEGRATION_TOKEN=
# Optional dedicated key for encrypting Garmin/Renpho credentials (defaults to JWT_SECRET)
CREDENTIALS_SECRET=

# Auto-start sync-worker on deploy when INTEGRATION_TOKEN is set (compose profile: sync)
# GARMIN_ENABLED / RENPHO_ENABLED also overridable in Admin; saving Garmin creds enables Garmin.
GARMIN_ENABLED=false
RENPHO_ENABLED=false
SYNC_INTERVAL_SECONDS=1800
FORGE_TZ=UTC

# Ollama defaults (overridable in Admin panel)
AI_ENABLED=false
# LAN or container hostname for your Ollama — not required if AI stays off
OLLAMA_URL=http://127.0.0.1:11434

# Home Assistant defaults (overridable in Admin panel)
HA_ENABLED=false
HA_MQTT_URL=
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=
HA_REST_URL=
HA_REST_TOKEN=

# Cloudflare Tunnel — only needed with: docker compose --profile tunnel
# Create a tunnel token in Zero Trust, then:
#   TUNNEL_TOKEN=eyJ...
# TUNNEL_TOKEN=

